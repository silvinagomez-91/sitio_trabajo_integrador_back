<div class="container" style="margin:100px 0">
    <div class="row">
        <div class="col-6 offset-3">
            <h4>Modificar la novedad</h4>
            <form action="/admin/novedades/modificar" method="post">
                <input type="hidden" value="{{novedad.id}}" name="id">
                <div class="mb-3 row">
                    <label for="">Servicios</label>
                    <input type="text" class="form-control" name="servicios" value="{{novedad.servicios}}">
                </div>
                <div class="mb-3 row">
                    <label for="">Precio Argentina</label>
                    <input type="text" class="form-control" name="precioargentina" value="{{novedad.precioargentina}}">
                </div>

                <div class="mb-3 row">
                    <label for="">Precio Internacional</label>
                    <textarea name="preciointernacional" class="form-control">{{novedad.preciointernacional}}</textarea>
                </div>
                <button type="submit" class="btn btn-primary">Modificar</button>
            </form>
            {{#if error}}
            <p>{{message}}</p>
            {{/if}}
        </div>


    </div>

</div>