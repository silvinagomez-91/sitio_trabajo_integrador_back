<div class="container" style="margin:100px auto">
    <div class="row">
        <div class="col-6 offset-3">
            <h4>Agregar una nueva novedad</h4>
            <form action="/admin/novedades/agregar" method="post">
                <div class="mb-3 row">
                    <input type="text" class="form-control" placeholder="Servicios" name="servicios">
                </div>
                <textarea type="text" class="form-control" placeholder="Precio Argentina" name="precioargentina"></textarea>
        </div>
        <div class="mb-3 row">
            <textarea type="Cuerpo" class="form-control" placeholder="Precio Internacional" name="preciointernacional"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Guardar</button>
        </form>
        {{#if error}}
        <p>{{message}}</p>
        {{/if}}
    </div>
</div>
</div>